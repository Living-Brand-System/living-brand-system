{
	"name": "living-brand-system",
	"version": "1.0.0",
	"description": "Living Brand System (LBS) - digital brand guideline operations system",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"check": "biome ci .",
		"check:write": "biome check --write .",
		"ci": "pnpm run check:graphic-runtime-catalogs && pnpm run check && pnpm run typecheck && pnpm run test:int && pnpm run build",
		"db:sync:local-to-remote": "bash scripts/sync-local-db-to-remote.sh",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
		"preview:build": "cross-env NEXT_DIST_DIR=.next-preview NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"preview:start": "cross-env NEXT_DIST_DIR=.next-preview NODE_OPTIONS=--no-deprecation PORT=3100 next start",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"generate:graphic-runtime-catalogs": "tsx scripts/generate-graphic-runtime-catalogs.ts",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "biome lint .",
		"migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
		"migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
		"migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"content:snapshot": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/export-guideline-content.ts && biome format --write scripts/data/guideline-content.json",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
		"typecheck": "tsc --noEmit",
		"check:graphic-runtime-catalogs": "tsx scripts/generate-graphic-runtime-catalogs.ts --check",
		"doctor": "pnpm run generate:graphic-runtime-catalogs && pnpm run generate:types && pnpm run check:write && pnpm run check && pnpm run typecheck",
		"doctor:react": "npx react-doctor@latest"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.39",
		"@ai-sdk/google": "^4.0.21",
		"@ai-sdk/openai": "^4.0.4",
		"@ai-sdk/react": "^4.0.0",
		"@carbon/icons-react": "^11.82.0",
		"@jsquash/webp": "^1.5.0",
		"@payloadcms/db-postgres": "3.85.1",
		"@payloadcms/email-resend": "^3.85.1",
		"@payloadcms/live-preview-react": "3.85.1",
		"@payloadcms/next": "3.85.1",
		"@payloadcms/plugin-mcp": "3.85.1",
		"@payloadcms/plugin-nested-docs": "3.85.1",
		"@payloadcms/plugin-search": "3.85.1",
		"@payloadcms/richtext-lexical": "3.85.1",
		"@payloadcms/storage-s3": "^3.85.1",
		"@payloadcms/translations": "^3.85.1",
		"@payloadcms/ui": "3.85.1",
		"@shadcn/react": "0.1.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tailwindcss/postcss": "^4.3.1",
		"@vercel/functions": "^3.9.5",
		"ai": "^7.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cross-env": "^7.0.3",
		"culori": "^4.0.2",
		"dialkit": "1.4.3",
		"dotenv": "16.4.7",
		"embla-carousel-autoplay": "8.6.0",
		"embla-carousel-react": "^8.6.0",
		"fflate": "0.8.3",
		"fontkit": "^2.0.4",
		"graphql": "^16.8.1",
		"html-to-image": "^1.11.13",
		"htmlparser2": "^10.0.0",
		"mediabunny": "^1.52.3",
		"motion": "^12.42.0",
		"next": "16.2.11",
		"next-themes": "^0.4.6",
		"p5": "1.11.10",
		"payload": "3.85.1",
		"payload-better-editor": "^1.3.0",
		"pdf-lib": "^1.17.1",
		"radix-ui": "^1.6.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"sharp": "0.35.0",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.1",
		"three": "0.185.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@carbon/layout": "^11.56.0",
		"@playwright/test": "1.61.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/culori": "^4.0.1",
		"@types/fontkit": "^2.0.9",
		"@types/node": "22.19.9",
		"@types/p5": "^1.7.7",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.185.1",
		"@vitejs/plugin-react": "4.5.2",
		"jsdom": "28.0.0",
		"shadcn": "^4.12.0",
		"tsx": "4.22.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.7.3",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": "22.x",
		"pnpm": "^9 || ^10"
	},
	"pnpm": {
		"overrides": {
			"@hono/node-server@<2.0.10": "2.0.10",
			"brace-expansion@>=3.0.0 <=5.0.7": "5.0.8",
			"dompurify@<=3.4.11": "3.4.12",
			"esbuild@<=0.24.2": "0.25.12",
			"esbuild@>=0.27.3 <0.28.1": "0.28.1",
			"fast-uri@>=3.0.0 <=3.1.3": "3.1.4",
			"immutable@>=4.0.0 <4.3.9": "4.3.9",
			"js-yaml@>=4.0.0 <4.3.0": "4.3.0",
			"postcss@<8.5.18": "8.5.18",
			"sharp@<0.35.0": "0.35.0",
			"undici@<7.28.0": "7.28.0"
		},
		"onlyBuiltDependencies": [
			"sharp",
			"esbuild",
			"unrs-resolver"
		],
		"patchedDependencies": {
			"sharp@0.35.0": "patches/sharp@0.35.0.patch"
		}
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
# `pnpm preview:build` 출력. dev 서버의 .next를 덮지 않으려고 따로 쓴다.
/.next-preview/
/out/

# production
/build

# misc
.DS_Store
*.pem
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

/media
# Blob 토큰이 없을 때 Payload가 업로드를 쓰는 로컬 디스크 경로(staticDir 기본값 = 컬렉션 slug)
/application-images/
/brand-icons/
/brand-logos/
/brand-typefaces/
/generated-images/
/sample-images/
/template-assets/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Graphify
/graphify-out/

# Local agent state (shared .agents skills/settings stay tracked)
.agents/settings.local.json
.codex/

# Local database operations
.db-backups/
.agents/worktrees/

# Local review calibration (검수기 회귀용 샘플·진단 스크립트 — 로컬 전용)
tests/fixtures/review/
scripts/diagnose-*.ts
# Throwaway 스파이크 스크립트 (dogfood·dry-run — 로컬 전용)
scripts/_*.ts
.gstack/
backups/

# Local build output
output/
temp/
.superpowers
.pnpm-store/
.playwright-cli/
# 에셋 원본은 기본적으로 추적하지 않는다. 단 HD CI 마스터 아트워크(ci/)와
# CI 금지 예시(do-dont/)는 force-add로 추적 중이다 — 어떤 코드도 읽지 않지만
# 브랜드 원본이고 워드마크 레터링 조사의 작업 세트다. 안 읽힌다는 이유로 지우지 말 것.
scripts/assets/
inventory/

# 개인 짬통. 지금까지 각자의 .git/info/exclude에만 있어서, 클론한 기여자가
# .scratch/에 파일을 넣으면 pnpm check가 그것까지 검사하며 깨졌다.
.scratch/
# 프로젝트 개인 지시 층(커밋하지 않는다). CLAUDE.md와 같이 자동 로드된다.
CLAUDE.local.md

# 스토리지에 직접 올리는 검수용 이미지 원본. 코드가 읽지 않는다.
image_samples/

# admin에 업로드하는 샘플 이미지 원본과 썸네일. 정본은 DB이고 코드가 읽지 않는다.
sample-images/

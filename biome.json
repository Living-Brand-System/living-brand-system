{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!node_modules",
			"!.next",
			"!build",
			"!coverage",
			"!playwright-report",
			"!test-results",
			"!blob-report",
			"!src/payload-types.ts",
			"!src/payload-generated-schema.ts",
			"!src/features/graphic-generation/graphic-runtimes/catalog/*.generated.ts",
			"!src/features/graphic-generation/graphic-runtimes/catalog/*.generated.client.ts",
			"!src/features/graph-generation/graph-runtimes/catalog/*.generated.ts",
			"!src/features/graph-generation/graph-runtimes/catalog/*.generated.client.ts",
			"!src/app/(payload)/admin",
			"!**/*.svg",
			"!migrations"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "all"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
